{
  "name": "symjs-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo of symjs: the base module @symjs/symjs and extend modules",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "build": "bun run --filter @symjs/symjs build && bun run --filter @symjs/mathjs --filter @symjs/physics-quantum build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "compat": "vitest run --coverage --reporter=dot && vitest run --config compat/vitest.config.ts",
    "corpus:generate": "UPDATE_CORPUS_TESTS=1 vitest run --config tools/sympy-corpus/totests/vitest.config.ts tools/sympy-corpus/totests/generate.test.ts --silent=false",
    "corpus:report": "vitest run --reporter=dot --reporter=./tools/sympy-corpus/corpus-report.ts .corpus.test.ts",
    "compat:category": "vitest run --config compat/vitest.config.ts compat/category.test.ts",
    "compat:test-extract": "python3 -B -m unittest discover -s tools/sympy-reference -p 'test_extract*.py'",
    "compat:extract-tests": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 -B tools/sympy-reference/extract_tests.py tools/sympy-corpus/tests-corpus < /dev/null",
    "compat:expand": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 -B tools/sympy-reference/extract.py tools/sympy-corpus/corpus.json --baseline tools/sympy-corpus/corpus.json < /dev/null",
    "compat:refresh": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 -B tools/sympy-reference/extract.py tools/sympy-corpus/corpus.json --baseline tools/sympy-corpus/corpus.json --refresh < /dev/null",
    "compat:extract": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 tools/sympy-reference/extract.py tools/sympy-corpus/corpus.json < /dev/null",
    "golden": "python3 tools/sympy-reference/generators/gen_golden.py packages/symjs/tests/golden/cases.json packages/symjs/tests/golden/expected.json",
    "lint": "oxlint --type-aware --deny-warnings packages",
    "test:package": "bun run build && bun scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
