{
  "name": "symjs-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo of symjs: the base module @symjs/symjs and extend modules",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "corpus:compat": "vitest run --coverage --reporter=dot && NODE_OPTIONS=--max-old-space-size=8192 vitest run --config tools/sympy-corpus/compat/vitest.config.ts",
    "corpus:generate": "bun tools/sympy-corpus/totests/generate.ts",
    "corpus:report": "vitest run --reporter=dot --reporter=./tools/sympy-corpus/corpus-report.ts .corpus.test.ts",
    "corpus:test-extract": "python3 -B -m unittest discover -s tools/sympy-reference -p 'test_extract*.py'",
    "corpus:extract:unittest": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 -B tools/sympy-reference/extract_unittest.py tools/sympy-corpus/unittest < /dev/null",
    "corpus:expand:doctest": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 -B tools/sympy-reference/extract_doctest.py tools/sympy-corpus/doctest --baseline tools/sympy-corpus/doctest < /dev/null",
    "corpus:refresh:doctest": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 -B tools/sympy-reference/extract_doctest.py tools/sympy-corpus/doctest --baseline tools/sympy-corpus/doctest --refresh < /dev/null",
    "corpus:extract:doctest": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 tools/sympy-reference/extract_doctest.py tools/sympy-corpus/doctest < /dev/null",
    "golden": "python3 tools/sympy-reference/generators/gen_golden.py packages/symjs/tests/golden/cases.json packages/symjs/tests/golden/expected.json",
    "lint": "oxlint --type-aware --deny-warnings packages",
    "docs:coverage": "bun tools/api-docs/coverage.ts --markdown docs/api-docs-coverage.md",
    "docs:examples": "bun tools/api-docs/examples.ts",
    "test:package": "node scripts/build.mjs && node scripts/check-package.mjs",
    "corpus:compat:doctest": "bun tools/sympy-corpus/compat/category.ts doctest",
    "corpus:compat:unittest": "bun tools/sympy-corpus/compat/category.ts unittest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
