{
  "name": "symjs-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo of symjs: the base module @symjs/symjs and extend modules",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "compat": "vitest run --coverage --reporter=dot && vitest run --config compat/vitest.config.ts",
    "compat:category": "vitest run --config compat/vitest.config.ts compat/category.test.ts",
    "compat:extract": "MPLBACKEND=Agg PYTHONHASHSEED=0 python3 compat/extract.py compat/corpus.json < /dev/null",
    "golden": "python3 scripts/gen_golden.py packages/symjs/tests/golden/cases.json packages/symjs/tests/golden/expected.json",
    "lint": "oxlint --type-aware --deny-warnings packages"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
