{
  "name": "@symjs/physics-quantum",
  "description": "Quantum physics for symjs (port of sympy.physics.quantum; extend module)",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@symjs/symjs": "workspace:^"
  },
  "devDependencies": {
    "@symjs/symjs": "workspace:^"
  }
}
